<?xml version="1.0"?>
<sdf version="1.8">

  <world name="obstacle_test">

    <!--
      IMPORTANT:
      Do not add Physics, Sensors, SceneBroadcaster or UserCommands
      plugins here.

      The current 41068 launch system loads those common Gazebo
      systems from config/ignition_server.config.
    -->


    <!-- ========================================================= -->
    <!-- Lighting                                                  -->
    <!-- ========================================================= -->

    <light name="sun" type="directional">

      <cast_shadows>1</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>

      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>

        <range>1000</range>

        <constant>0.9</constant>

        <linear>0.01</linear>

        <quadratic>0.001</quadratic>

      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>

    </light>


    <!-- ========================================================= -->
    <!-- World properties                                          -->
    <!-- ========================================================= -->

    <gravity>0 0 -9.81</gravity>

    <magnetic_field>
      6e-06 2.3e-05 -4.2e-05
    </magnetic_field>

    <atmosphere type="adiabatic"/>


    <physics name="default_physics" type="ignored">

      <max_step_size>0.01</max_step_size>

      <real_time_factor>1</real_time_factor>

      <real_time_update_rate>100</real_time_update_rate>

    </physics>


    <scene>

      <ambient>1.0 1.0 1.0</ambient>

      <background>0.8 0.8 0.8</background>

      <shadows>1</shadows>

    </scene>


    <spherical_coordinates>

      <latitude_deg>0.0</latitude_deg>

      <longitude_deg>0.0</longitude_deg>

      <elevation>10.0</elevation>

      <heading_deg>0</heading_deg>

      <surface_model>EARTH_WGS84</surface_model>

    </spherical_coordinates>


    <!-- ========================================================= -->
    <!-- Ground                                                    -->
    <!-- ========================================================= -->

    <include>

      <uri>model://grass_plane</uri>

      <name>grass_plane</name>

      <pose>0 0 0 0 0 0</pose>

    </include>


    <!-- ========================================================= -->
    <!-- Landmarks                                                 -->
    <!-- Provide some geometry for LiDAR / SLAM                    -->
    <!-- ========================================================= -->

    <include>

      <uri>model://autumn_tree</uri>

      <name>test_tree_1</name>

      <pose>-5 5 0 0 0 0</pose>

    </include>


    <include>

      <uri>model://autumn_tree</uri>

      <name>test_tree_2</name>

      <pose>-5 -5 0 0 0 0</pose>

    </include>


    <include>

      <uri>model://autumn_tree</uri>

      <name>test_tree_3</name>

      <pose>5 5 0 0 0 0</pose>

    </include>


    <include>

      <uri>model://autumn_tree</uri>

      <name>test_tree_4</name>

      <pose>5 -5 0 0 0 0</pose>

    </include>


    <!-- ========================================================= -->
    <!-- Obstacle-avoidance test box                               -->
    <!-- ========================================================= -->

    <model name="test_box">

      <static>true</static>

      <!-- Initially away from Husky's direct route -->
      <pose>3 0 0.5 0 0 0</pose>


      <link name="box_link">

        <collision name="collision">

          <geometry>

            <box>

              <size>0.6 0.8 1.0</size>

            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>

              <size>0.6 0.8 1.0</size>

            </box>

          </geometry>


          <material>

            <ambient>0.8 0.1 0.1 1</ambient>

            <diffuse>0.8 0.1 0.1 1</diffuse>

          </material>

        </visual>

      </link>

    </model>


  </world>

</sdf>