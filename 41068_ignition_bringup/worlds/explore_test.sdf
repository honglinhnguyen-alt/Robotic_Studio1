<?xml version="1.0"?>
<sdf version="1.8">

  <world name="explore_test">

    <!-- ================================================== -->
    <!-- GAZEBO SYSTEMS -->
    <!-- ================================================== -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>


    <!-- ================================================== -->
    <!-- LIGHTING -->
    <!-- ================================================== -->

    <light name="sun" type="directional">
      <pose>0 0 80 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.81</gravity>


    <!-- ================================================== -->
    <!-- GROUND -->
    <!-- IMPORTANT: forest_plane must be at least 100x100 -->
    <!-- ================================================== -->

    <include>
      <uri>model://forest_plane</uri>
      <name>forest_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>


    <!-- ================================================== -->
    <!-- BOUNDARY WALLS -->
    <!-- 100 m x 100 m -->
    <!-- x = -50 .. +50 -->
    <!-- y = -50 .. +50 -->
    <!-- ================================================== -->


    <!-- NORTH WALL -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 50 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>100 0.2 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>100 0.2 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- SOUTH WALL -->
    <model name="south_wall">
      <static>true</static>
      <pose>0 -50 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>100 0.2 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>100 0.2 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- EAST WALL -->
    <model name="east_wall">
      <static>true</static>
      <pose>50 0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 100 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 100 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- WEST WALL -->
    <model name="west_wall">
      <static>true</static>
      <pose>-50 0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 100 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 100 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ================================================== -->
    <!-- NEAR OBSTACLES -->
    <!-- Keep centre around (0,0) clear -->
    <!-- ================================================== -->


    <model name="obstacle_1">
      <static>true</static>
      <pose>-8 8 1 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3 3 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>3 3 2</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


