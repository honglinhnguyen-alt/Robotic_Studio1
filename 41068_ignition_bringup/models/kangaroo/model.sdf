<?xml version="1.0"?>
<sdf version="1.8">
  <model name="kangaroo">
    <static>true</static>

    <link name="link">
    <visual name="visual">
      <geometry>
        <mesh>
          <uri>meshes/kangaroo.dae</uri>
          <scale>1 1 1</scale>
        </mesh>
      </geometry>

      <plugin
        filename="ignition-gazebo-thermal-system"
        name="gz::sim::systems::Thermal">
        <temperature>322.15</temperature>
      </plugin>

    </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>meshes/kangaroo.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>
