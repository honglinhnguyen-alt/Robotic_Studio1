<?xml version="1.0" ?>
<sdf version="1.8">

  <model name="rock_1">

    <static>true</static>

    <link name="rock_link">

      <visual name="rock_visual">

        <geometry>
          <mesh>
            <uri>meshes/rock_1.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

        <!-- same background temperature as autumn_tree -->
        <plugin filename="ignition-gazebo-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>300.15</temperature>
        </plugin>
      </visual>

      <collision name="rock_collision">

        <geometry>
          <mesh>
            <uri>meshes/rock_1.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

      </collision>

    </link>

  </model>

</sdf>