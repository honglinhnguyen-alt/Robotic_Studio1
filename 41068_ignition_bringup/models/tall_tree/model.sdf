<?xml version="1.0" ?>
<sdf version="1.8">

  <model name="tall_tree">

    <static>true</static>

    <link name="tree_link">

      <visual name="tree_visual">
        <geometry>
          <mesh>
            <uri>meshes/tall_tree.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="tree_collision">
        <geometry>
          <mesh>
            <uri>meshes/tall_tree.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

    </link>

  </model>

</sdf>
