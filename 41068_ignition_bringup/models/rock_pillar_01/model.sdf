<?xml version="1.0"?>
<sdf version="1.8">
  <model name="rock_pillar_01">
    <static>true</static>
    <link name="rock_link">
      <visual name="rock_visual">
        <geometry>
          <mesh>
            <uri>model://rock_pillar_01/meshes/rock_pillar_01.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr><metal>
            <albedo_map>model://rock_pillar_01/textures/rock_pillar_01_base_color.png</albedo_map>
            <normal_map>model://rock_pillar_01/textures/rock_pillar_01_normal.png</normal_map>
            <roughness_map>model://rock_pillar_01/textures/rock_pillar_01_roughness.png</roughness_map>
            <metalness>0</metalness>
            <roughness>1</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="rock_collision">
        <geometry>
          <mesh>
            <uri>model://rock_pillar_01/meshes/collision.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
